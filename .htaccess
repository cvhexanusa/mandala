# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/smaknisc/public_html/sapaenam"
PassengerBaseURI "/"
PassengerNodejs "/home/smaknisc/nodevenv/public_html/sapaenam/24/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# 1. Pastikan hanya menyajikan file hasil build produksi
DirectoryIndex dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Redirect request storage langsung ke backend SIMAK
  RewriteRule ^storage/(.*)$ https://centralsimak.smakniscjr.sch.id/storage/$1 [R=302,L,QSA]

  # 3. Paksa Root URL dan index.html agar SELALU disajikan dari dist/index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 4. Blokir akses langsung ke file source dev (/src/)
  RewriteRule ^src/ - [F,L]

  # 5. Jika file yang dicari ada di dalam folder /dist/ (seperti /assets/*), serve dari /dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 6. SPA Fallback: Semua URL route React diarahkan ke dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ dist/index.html [L]
</IfModule>

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
